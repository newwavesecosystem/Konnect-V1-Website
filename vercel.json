{
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|konn3ct-logo\\.ico|robots\\.txt|llms\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|static/|\\.well-known/|robots\\.txt|llms\\.txt|favicon\\.ico|konn3ct-logo\\.ico|fonts\\.css|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
