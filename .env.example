# ==============================================================================
# KONN3CT LANDING PAGE × NEWWAVES ECOSYSTEM ODOO 18 CRM — ENVIRONMENT TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to `.env.local` for local development or configure these
#    variables in the Vercel Project Settings (Environment Variables).
# 2. NEVER commit real API keys, passwords, or production secrets to Git.
# 3. NEVER prefix Odoo credentials with `REACT_APP_` (which would expose them
#    to the browser bundle). All variables below are strictly server-side.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ODOO 18 CONNECTION & AUTHENTICATION (VERIFIED ENVIRONMENT)
# ------------------------------------------------------------------------------
# Root origin of the Newwaves Ecosystem Odoo 18 Enterprise (`18.0+e`) server.
# Note: Do NOT append `/odoo/crm` (browser route); the backend automatically
# connects to `/xmlrpc/2/common` and `/xmlrpc/2/object` at the root origin.
ODOO_URL=https://www.newwavesecosystem.com

# Verified Database Identifier:
# - Staging:    newwavesecosystem-staging
# - Production: newwavesecosystem
ODOO_DB=newwavesecosystem-staging

# Dedicated Least-Privilege Odoo 18 Integration Service Account login (email/username)
ODOO_USERNAME=

# Odoo 18 User API Key generated under Preferences -> Account Security -> New API Key
ODOO_API_KEY=

# Upstream XML-RPC request timeout in milliseconds (default: 10000)
ODOO_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 2. CRM ORGANIZATION, SALES TEAM & OWNERSHIP ROUTING
# ------------------------------------------------------------------------------
# Target Sales Team name in Odoo CRM (looked up dynamically via `crm.team` if ID is omitted)
ODOO_CRM_TEAM_NAME=Konn3ct Growth & Partnerships

# Optional explicit numeric `crm.team` ID (overrides name lookup if provided)
ODOO_CRM_TEAM_ID=

# Default Odoo `crm.lead` record type ('lead' = Unqualified Lead; 'opportunity' = Pipeline Opportunity)
# Keep as 'lead' so Waitlist, Early Access & new enquiries enter as unqualified leads first.
ODOO_DEFAULT_LEAD_TYPE=lead

# Optional authorized Odoo `res.users` numeric IDs for specialized lead ownership routing:
ODOO_DEFAULT_OWNER_UID=
ODOO_DEMO_OWNER_UID=
ODOO_PARTNERSHIP_OWNER_UID=
ODOO_WAITLIST_OWNER_UID=
ODOO_EARLY_ACCESS_OWNER_UID=
ODOO_GENERAL_OWNER_UID=

# Enable automatic calculation of verified Konn3ct Lead Scoring fields (`x_score_fit`, `x_score_intent`, `x_score_engagement`, `x_score_revenue`)
ODOO_ENABLE_LEAD_SCORING=true

# Automatically create classification tags in `crm.tag` if not yet present
ODOO_AUTO_CREATE_TAGS=true

# Enforce Konn3ct Sales Team & Owner after `crm.lead.create` if upstream hot-lead automations reassign ownership
ODOO_ENFORCE_KONN3CT_OWNER=true

# Optional JSON map of verified Odoo custom fields (`x_*`), e.g.:
# ODOO_CUSTOM_FIELD_MAP_JSON={"enquiryType":"x_konn3ct_enquiry_type","route":"x_konn3ct_segment"}
ODOO_CUSTOM_FIELD_MAP_JSON=

# ------------------------------------------------------------------------------
# 3. DELIVERY MODE, DURABLE QUEUE & IDEMPOTENCY
# ------------------------------------------------------------------------------
# Integration mode: 'live' | 'staging' | 'queue'
KONN3CT_CRM_MODE=staging

# Set to 'true' to accept validated leads into a durable fallback queue when Odoo
# is temporarily unreachable or credentials are pending provisioning.
KONN3CT_ENABLE_DURABLE_QUEUE=false
KONN3CT_QUEUE_FILE=
KONN3CT_IDEMPOTENCY_FILE=

# ------------------------------------------------------------------------------
# 4. SECURITY, ORIGIN & ABUSE PROTECTION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins for POST /api/leads in production
# e.g. https://konn3ct.com,https://www.konn3ct.com
KONN3CT_ALLOWED_ORIGINS=

# Sliding-window rate limit per IP address (default: 8 submissions per 600000ms / 10 mins)
KONN3CT_RATE_LIMIT_MAX=8
KONN3CT_RATE_LIMIT_WINDOW_MS=600000
